# Database
DATABASE_URL="postgresql://classroom:classroom@localhost:5432/classroom?schema=public"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Rate limiting (optional — falls back to in-memory when unset)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Stripe (optional — ledger still works without live Stripe)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Wakalah placement fee (fixed rate, no compounding)
PLACEMENT_FEE_RATE="0.15"

# QR event tokens
QR_SIGNING_SECRET="generate-with-openssl-rand-base64-32"

# Node
NODE_ENV="development"
